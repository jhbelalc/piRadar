<Project Sdk="Microsoft.NET.Sdk">

    <!-- Extensión de compartir de iOS: solo copia la imagen a la carpeta del App Group; piRadar la lee al abrirse.
         No usa MAUI ni Blazor: las extensiones tienen un límite de memoria muy inferior al de una app. -->
    <PropertyGroup>
        <TargetFramework>net10.0-ios26.0</TargetFramework>
        <ValidateXcodeVersion>false</ValidateXcodeVersion>
        <OutputType>Library</OutputType>
        <IsAppExtension>true</IsAppExtension>
        <RootNamespace>PiRadar.ShareExtension</RootNamespace>
        <ApplicationId>com.jhbelalc.piradar.share</ApplicationId>
        <ApplicationTitle>piRadar</ApplicationTitle>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <CodesignKey>-</CodesignKey>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
        <CodesignKey>Apple Distribution</CodesignKey>
        <CodesignProvision>piRadar Share App Store</CodesignProvision>
    </PropertyGroup>

    <ItemGroup>
        <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
    </ItemGroup>

</Project>
