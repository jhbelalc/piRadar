<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sin respaldo del sistema: la clave de la BD vive en el Keystore, que no se respalda,
         así que una BD restaurada sería ilegible. El respaldo soportado es el export/import cifrado propio.
         allowBackup=false cubre la nube hasta Android 11; data_extraction_rules también la transferencia
         entre dispositivos de Android 12+. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/appicon"
        android:roundIcon="@mipmap/appicon_round"
        android:supportsRtl="true"></application>
    <!-- Sin INTERNET en Release: ver ReleaseManifestOverlay.xml. Debug la conserva para el depurador. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fotos de recibos con MediaPicker. En Android 13+ la galería usa el selector del sistema, sin permiso. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Acerca de: correo y sitio web del desarrollador (Launcher.TryOpenAsync pregunta si hay una app que los abra). -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
