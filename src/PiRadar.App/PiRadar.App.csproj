<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios26.0</TargetFrameworks>
        <ValidateXcodeVersion>false</ValidateXcodeVersion>

        <OutputType>Exe</OutputType>
        <RootNamespace>PiRadar.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>piRadar</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.jhbelalc.piradar</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.1.3</ApplicationDisplayVersion>
        <!-- Subir en cada APK o AAB que se entrega: Android no instala encima una versión con número menor. -->
        <ApplicationVersion>17</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- Textos completos de las licencias de terceros (página Licencias), sin depender de archivos sueltos. -->
    <ItemGroup>
        <EmbeddedResource Include="Licenses\*.txt" LogicalName="Licenses.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#00695C" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#00695C" BaseSize="128,128" />

    </ItemGroup>

    <!-- Release para teléfonos (ARM64): sin x86_64, que solo sirve al emulador y duplicaba cada librería nativa (APK de
         46,7 MB). Release en el emulador: -p:PiRadarEmulator=true (no -p:RuntimeIdentifiers, que se propaga a Core y Data).
         Google Play (-p:PiRadarPlayStore=true, tools/build-aab.sh): .aab con ARM64 y x86_64; Play entrega a cada
         dispositivo solo su arquitectura, así que x86_64 (Chromebooks, emuladores) no engorda la descarga. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' And $(TargetFramework.Contains('-android'))">
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="'$(PiRadarEmulator)' == 'true'">android-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="'$(PiRadarPlayStore)' == 'true'">android-arm64;android-x64</RuntimeIdentifiers>
        <AndroidPackageFormat Condition="'$(PiRadarPlayStore)' == 'true'">aab</AndroidPackageFormat>

        <!-- Firma con la clave propia de piRadar (fuera del repo; su contraseña está en el llavero de macOS y la pasa
             tools/build-apk.sh). Las actualizaciones solo se instalan encima si van firmadas con la misma clave. -->
        <PiRadarKeyStore Condition="'$(PiRadarKeyStore)' == ''">$(MSBuildThisFileDirectory)..\..\..\piRadar-firma\piradar.keystore</PiRadarKeyStore>
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyStore>$(PiRadarKeyStore)</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>piradar</AndroidSigningKeyAlias>
        <AndroidSigningStorePass>env:PIRADAR_KEYSTORE_PASS</AndroidSigningStorePass>
        <AndroidSigningKeyPass>env:PIRADAR_KEYSTORE_PASS</AndroidSigningKeyPass>
    </PropertyGroup>

    <!-- Release de iOS para el App Store (tools/build-ipa.sh): iPhone/iPad reales, firmado con el certificado Apple
         Distribution y el perfil "piRadar App Store" (creados con la API de App Store Connect; la clave privada y el .p12
         están en ../piRadar-firma, la contraseña del .p12 en el llavero, servicio piradar-ios-distribution-p12). -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' And $(TargetFramework.Contains('-ios'))">
        <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
        <CodesignKey>Apple Distribution</CodesignKey>
        <CodesignProvision>piRadar App Store</CodesignProvision>
    </PropertyGroup>

    <!-- Sin la clave propia no se genera un Release: firmado con otra clave no se podría instalar encima del actual. -->
    <Target Name="PiRadarCheckSigningKey" BeforeTargets="BeforeBuild"
            Condition="'$(Configuration)' == 'Release' And $(TargetFramework.Contains('-android'))">
        <Error Condition="!Exists('$(PiRadarKeyStore)')"
               Text="No se encontró la clave de firma de piRadar en $(PiRadarKeyStore). Cópiala ahí o indica otra ruta con -p:PiRadarKeyStore=..." />
        <Error Condition="'$(PIRADAR_KEYSTORE_PASS)' == ''"
               Text="Falta la contraseña de la clave (PIRADAR_KEYSTORE_PASS). Compila el APK con tools/build-apk.sh, que la lee del llavero de macOS." />
    </Target>

    <!-- Release sin permisos de red en Android (la app funciona 100 % sin conexión). -->
    <ItemGroup Condition="'$(Configuration)' == 'Release' And $(TargetFramework.Contains('-android'))">
        <AndroidManifestOverlay Include="Platforms\Android\ReleaseManifestOverlay.xml" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="MudBlazor" Version="9.10.0" />
        <PackageReference Include="Plugin.Maui.OCR" Version="1.1.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PiRadar.Data\PiRadar.Data.csproj" />
    </ItemGroup>

</Project>
