@implements IDisposable
@inject HomeTitleState HomeTitleState

<div>
    <div class="d-flex align-center gap-2 px-4" style="height: var(--mud-appbar-height)">
        <MudIcon Icon="@Icons.Material.Rounded.Radar" Color="Color.Primary" />
        <AppTitle Title="@HomeTitleState.Title" Subtitle="piRadar" />
    </div>
    <MudDivider />
    <MudNavMenu Color="Color.Primary" Class="py-2">
        @foreach (var item in MainItems)
        {
            <MudNavLink Href="@item.Href" Match="item.Match" Icon="@item.Icon" Disabled="!item.Enabled">@item.Label</MudNavLink>
        }
        <MudDivider Class="my-2" />
        @foreach (var item in NavItems.MoreItems)
        {
            <MudNavLink Href="@item.Href" Match="item.Match" Icon="@item.Icon" Disabled="!item.Enabled">@item.Label</MudNavLink>
        }
    </MudNavMenu>
</div>

@code {
    private static readonly NavItem[] MainItems =
    [
        NavItems.Home,
        NavItems.Transactions,
        NavItems.NewTransaction with { Label = "Nuevo movimiento" },
        NavItems.Analytics,
    ];

    protected override void OnInitialized() => HomeTitleState.Changed += OnTitleChanged;

    private void OnTitleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => HomeTitleState.Changed -= OnTitleChanged;
}
