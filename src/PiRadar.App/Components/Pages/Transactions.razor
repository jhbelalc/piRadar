@page "/transactions"
@using PiRadar.Core.Analytics
@inject ITransactionRepository TransactionRepository
@inject ICategoryRepository CategoryRepository
@inject IPaymentMethodRepository PaymentMethodRepository
@inject TransactionsViewState State

<PageBar Title="@Pick("Movimientos", "Transactions")" HelpTopics="HelpTopics.Transactions">
    <Actions>
        <MudIconButton Icon="@Icons.Material.Rounded.Search" Color="Color.Inherit" id="search-button"
                       aria-label="@Pick("Buscar", "Search")" OnClick="ToggleSearchAsync" />
    </Actions>
</PageBar>

<MudContainer MaxWidth="MaxWidth.Medium" Class="page-content">
    <MudStack Spacing="3">
        @if (State.SearchOpen)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                <MudStack Spacing="2">
                    <MudTextField T="string" Value="State.SearchText" ValueChanged="SetSearchTextAsync" Immediate="true" DebounceInterval="250"
                                  Label="@Pick("Buscar movimientos", "Search transactions")" id="search-text"
                                  Placeholder="@Pick("Comercio, descripción, notas, monto…", "Merchant, description, notes, amount…")"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" AutoFocus="true" />
                    <CategoryFilterPicker Value="State.SearchCategoryId" ValueChanged="SetSearchCategoryAsync" Kind="State.Type" />
                    <div class="d-flex gap-3">
                        <div id="search-from" style="flex: 1">
                            <MudDatePicker Date="State.SearchRange.Start" DateChanged="SetSearchFromAsync" Label="@Pick("Desde", "From")"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="@DateFormat"
                                           PickerVariant="PickerVariant.Dialog" AutoClose="true" ShowToolbar="false"
                                           Disabled="State.SearchWholeHistory" />
                        </div>
                        <div id="search-to" style="flex: 1">
                            <MudDatePicker Date="State.SearchRange.To.ToDateTime(TimeOnly.MinValue)" DateChanged="SetSearchToAsync" Label="@Pick("Hasta", "To")"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="@DateFormat"
                                           PickerVariant="PickerVariant.Dialog" AutoClose="true" ShowToolbar="false"
                                           Disabled="State.SearchWholeHistory" />
                        </div>
                    </div>
                    <MudSwitch T="bool" Value="State.SearchWholeHistory" ValueChanged="SetSearchWholeHistoryAsync" Color="Color.Primary"
                               Label="@Pick("Todo el historial", "Whole history")" id="search-whole-history" />
                </MudStack>
            </MudPaper>
        }

        @if (State.IsSearching)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary" id="search-count">@SearchCount()</MudText>
        }
        else
        {
            <PeriodSelector Value="State.Period" ValueChanged="SetPeriodAsync" />
        }

        @if (_totals.Count > 0)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                @* Una moneda por bloque: en el teléfono Gastos / Ingresos / Balance van en filas (los montos largos como
                   "COP $16,716,159" no caben en tres columnas); desde 600 px van en tres columnas. *@
                @foreach (var totals in _totals)
                {
                    <div class="totals-block">
                        <MudText Typo="Typo.subtitle2">@totals.Currency</MudText>
                        @if (totals.HasOpening)
                        {
                            <div class="totals-opening">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Pick("Saldo inicial", "Opening balance")</MudText>
                                <MudText Typo="Typo.body2" Class="@(totals.Opening.AmountMinor < 0 ? "money-expense" : "money-income")">@totals.Opening</MudText>
                            </div>
                        }
                        <div class="totals-cols">
                            <div class="totals-item">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Pick("Gastos", "Expenses")</MudText>
                                <MudText Typo="Typo.body2" Class="money-expense">@totals.Expenses</MudText>
                            </div>
                            <div class="totals-item">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Pick("Ingresos", "Income")</MudText>
                                <MudText Typo="Typo.body2" Class="money-income">@totals.Income</MudText>
                            </div>
                            <div class="totals-item">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Pick("Balance", "Balance")</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 600">@totals.Balance</MudText>
                            </div>
                        </div>
                    </div>
                }
            </MudPaper>
        }

        <MudChipSet T="string" SelectedValue="@(State.Type?.ToString() ?? AllTypes)" SelectedValueChanged="SetTypeAsync"
                    SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Color="Color.Primary" Variant="Variant.Text">
            <MudChip T="string" Value="AllTypes" Text="@Pick("Todos", "All")" id="filter-all" />
            <MudChip T="string" Value="@nameof(TransactionType.Expense)" Text="@Pick("Gastos", "Expenses")" id="filter-expense" />
            <MudChip T="string" Value="@nameof(TransactionType.Income)" Text="@Pick("Ingresos", "Income")" id="filter-income" />
        </MudChipSet>

        @if (_transactions is null)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (_transactions.Count == 0)
        {
            @OpeningRows()
            <MudStack AlignItems="AlignItems.Center" Class="py-8" Spacing="3">
                <MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" Size="Size.Large" Class="mud-text-secondary" />
                @if (State.IsSearching)
                {
                    <MudText Class="mud-text-secondary">@Pick("No se encontró nada con esa búsqueda.", "Nothing matches that search.")</MudText>
                }
                else
                {
                    <MudText Class="mud-text-secondary">@Pick("No hay movimientos en este periodo.", "No transactions in this period.")</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="transactions/new"
                               StartIcon="@Icons.Material.Rounded.Add">@Pick("Registrar movimiento", "Add transaction")</MudButton>
                }
            </MudStack>
        }
        else
        {
            @foreach (var day in _transactions.Take(MaxSearchRows).GroupBy(t => t.OccurredAt.Date))
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-1 ml-1">
                        @DateLabels.Day(day.Key, DateTime.Today)
                    </MudText>
                    <MudPaper Elevation="0" Outlined="true">
                        <MudList T="Transaction" Dense="true">
                            @foreach (var t in day)
                            {
                                <TransactionListItem Transaction="t" Category="_categories.GetValueOrDefault(t.CategoryId)"
                                                     PaymentMethod="PaymentMethodOf(t)" />
                            }
                        </MudList>
                    </MudPaper>
                </div>
            }

            @if (State.IsSearching && _transactions.Count > MaxSearchRows)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary text-center">
                    @Pick($"Se muestran los {MaxSearchRows} más recientes. Afina la búsqueda para ver el resto.",
                          $"Showing the {MaxSearchRows} most recent. Narrow the search to see the rest.")
                </MudText>
            }

            @OpeningRows()
        }
    </MudStack>
</MudContainer>

@code {
    /// <summary>
    /// "Saldo inicial": lo que quedó al cerrar el periodo anterior, una fila por moneda. Va al final porque la lista va
    /// del más reciente al más antiguo y es lo primero que pasa en el periodo. No se muestra al filtrar por gastos o ingresos.
    /// </summary>
    private RenderFragment OpeningRows() => __builder =>
    {
        var rows = _totals.Where(t => t.HasOpening).ToList();
        if (State.Type is null && rows.Count > 0 && !State.IsSearching)
        {
            <div>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-1 ml-1">
                    @DateLabels.Short(State.Period.Start)
                </MudText>
                <MudPaper Elevation="0" Outlined="true">
                    <MudList T="string" Dense="true">
                        @foreach (var totals in rows)
                        {
                            <MudListItem T="string" Class="opening-balance-item">
                                <div class="d-flex align-center gap-3">
                                    <IconAvatar Icon="account_balance_wallet" />
                                    <div style="min-width: 0; flex: 1">
                                        <MudText>@Pick("Saldo inicial", "Opening balance")</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @Pick("Lo que quedó del periodo anterior", "Carried over from the previous period")
                                        </MudText>
                                    </div>
                                    <MudText Class="@(totals.Opening.AmountMinor < 0 ? "money-expense" : "money-income")" Style="white-space: nowrap; font-variant-numeric: tabular-nums">
                                        @totals.Opening
                                    </MudText>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </div>
        }
    };

    private IReadOnlyList<Transaction>? _transactions;
    private IReadOnlyList<CurrencyTotals> _totals = [];
    private Dictionary<int, Category> _categories = [];
    private Dictionary<int, PaymentMethod> _paymentMethods = [];

    protected override async Task OnInitializedAsync()
    {
        // Con archivados: los movimientos viejos pueden usarlos.
        _categories = (await CategoryRepository.GetAllAsync(includeArchived: true)).ToDictionary(c => c.Id);
        _paymentMethods = (await PaymentMethodRepository.GetAllAsync(includeArchived: true)).ToDictionary(p => p.Id);
        await LoadAsync();
    }

    private const int MaxSearchRows = 300;

    private async Task LoadAsync()
    {
        if (State.IsSearching)
        {
            await SearchAsync();
            return;
        }

        var all = await TransactionRepository.QueryAsync(
            TransactionFilter.Between(State.Period.Start, State.Period.End));
        // Saldo inicial: lo que quedó con todo lo anterior al periodo (se hereda de un mes al siguiente).
        var before = await TransactionRepository.QueryAsync(new TransactionFilter { To = State.Period.Start });
        _totals = CurrencyTotals.ByCurrency(all, OpeningBalance.ByCurrency(before));
        _transactions = State.Type is { } type ? all.Where(t => t.Type == type).ToList() : all;
    }

    /// <summary>
    /// Busca entre Desde y Hasta, o en todo el historial (ignora el periodo); las fechas van en la consulta y el texto y la
    /// categoría se evalúan en memoria sin tildes ni mayúsculas.
    /// </summary>
    private async Task SearchAsync()
    {
        var whole = State.SearchWholeHistory;
        var all = await TransactionRepository.QueryAsync(new TransactionFilter
        {
            Type = State.Type,
            From = whole ? null : State.SearchRange.Start,
            To = whole ? null : State.SearchRange.EndExclusive,
        });
        var tokens = TransactionSearch.Tokens(State.SearchText);
        var categoryIds = State.SearchCategoryId is { } id
            ? TransactionSearch.CategoryAndChildren(id, _categories.Values)
            : null;
        _transactions = all.Where(t => TransactionSearch.Matches(t,
            _categories.GetValueOrDefault(t.CategoryId)?.Name, PaymentMethodOf(t)?.Name, tokens, categoryIds)).ToList();
        _totals = CurrencyTotals.ByCurrency(_transactions);
    }

    private Task ToggleSearchAsync()
    {
        State.SearchOpen = !State.SearchOpen;
        // Al abrir y al cerrar: si la app quedó abierta de un mes a otro, se sugiere el mes nuevo.
        State.SearchRange = SearchDateRange.MonthToDate(DateOnly.FromDateTime(DateTime.Today));
        State.SearchWholeHistory = false;
        if (!State.SearchOpen)
        {
            State.SearchText = string.Empty;
            State.SearchCategoryId = null;
        }

        return LoadAsync();
    }

    private string DateFormat => IsEnglish ? "MM/dd/yyyy" : "dd/MM/yyyy";

    private Task SetSearchFromAsync(DateTime? date) =>
        date is { } d ? SetSearchRangeAsync(State.SearchRange.WithFrom(DateOnly.FromDateTime(d))) : Task.CompletedTask;

    private Task SetSearchToAsync(DateTime? date) =>
        date is { } d ? SetSearchRangeAsync(State.SearchRange.WithTo(DateOnly.FromDateTime(d))) : Task.CompletedTask;

    private Task SetSearchRangeAsync(SearchDateRange range)
    {
        State.SearchRange = range;
        return LoadAsync();
    }

    private Task SetSearchWholeHistoryAsync(bool whole)
    {
        State.SearchWholeHistory = whole;
        return LoadAsync();
    }

    /// <summary>"12 resultados del 1 oct 2026 al 26 oct 2026", "… el 26 oct 2026" o "… en todo el historial".</summary>
    private string SearchCount()
    {
        if (_transactions is null)
        {
            return string.Empty;
        }

        var n = _transactions.Count;
        if (State.SearchWholeHistory)
        {
            return n == 1
                ? Pick("1 resultado en todo el historial", "1 result in your whole history")
                : Pick($"{n} resultados en todo el historial", $"{n} results in your whole history");
        }

        var from = DateLabels.Short(State.SearchRange.Start);
        var to = DateLabels.Short(State.SearchRange.To.ToDateTime(TimeOnly.MinValue));
        var results = n == 1 ? Pick("1 resultado", "1 result") : Pick($"{n} resultados", $"{n} results");
        return State.SearchRange.From == State.SearchRange.To
            ? Pick($"{results} el {from}", $"{results} on {from}")
            : Pick($"{results} del {from} al {to}", $"{results} from {from} to {to}");
    }

    private Task SetSearchTextAsync(string? text)
    {
        State.SearchText = text ?? string.Empty;
        return LoadAsync();
    }

    private Task SetSearchCategoryAsync(int? categoryId)
    {
        State.SearchCategoryId = categoryId;
        return LoadAsync();
    }

    private Task SetPeriodAsync(Period period)
    {
        State.Period = period;
        return LoadAsync();
    }

    private const string AllTypes = "All";

    private Task SetTypeAsync(string? value)
    {
        State.Type = Enum.TryParse<TransactionType>(value, out var type) ? type : null;
        return LoadAsync();
    }

    private PaymentMethod? PaymentMethodOf(Transaction t) =>
        t.PaymentMethodId is { } id ? _paymentMethods.GetValueOrDefault(id) : null;
}
