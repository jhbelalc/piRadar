@page "/"
@using System.Text
@using PiRadar.Data
@inject DatabaseHost Host

@* TEMPORAL: diagnóstico de la BD cifrada en el dispositivo. Se reemplaza por el Dashboard. *@
<h1>piRadar</h1>
<pre style="white-space: pre-wrap; font-size: 12px">@_output</pre>

@code {
    private string _output = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var info = await Host.Database.GetInfoAsync();
        var header = new byte[16];
        await using (var file = new FileStream(Host.DatabasePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
        {
            await file.ReadExactlyAsync(header);
        }

        var sb = new StringBuilder();
        sb.AppendLine($"Status={Host.Status}");
        sb.AppendLine($"FileCreatedUtc={File.GetCreationTimeUtc(Host.DatabasePath):O}");
        sb.AppendLine($"Now={DateTime.UtcNow:O}");
        sb.AppendLine($"PlainSqliteHeader={Encoding.ASCII.GetString(header) == "SQLite format 3\0"}");
        sb.AppendLine($"Info={info}");
        _output = sb.ToString();

        Console.WriteLine("DBCHECK_BEGIN\n" + _output + "DBCHECK_END");
        await File.WriteAllTextAsync(Path.Combine(FileSystem.AppDataDirectory, "db-check.txt"), _output);
    }
}
