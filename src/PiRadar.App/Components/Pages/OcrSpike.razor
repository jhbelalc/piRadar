@page "/ocr-spike"
@using System.Diagnostics
@using System.Text
@using Plugin.Maui.OCR
@inject IOcrService Ocr

@* SPIKE: evalúa Plugin.Maui.OCR con un recibo de prueba empaquetado. *@
<h1>OCR spike</h1>
<pre style="white-space: pre-wrap; font-size: 12px">@_output</pre>

@code {
    private string _output = "Reconociendo...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var sb = new StringBuilder();
        try
        {
            await using var stream = await FileSystem.OpenAppPackageFileAsync("receipt-sample.jpg");
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var sw = Stopwatch.StartNew();
            await Ocr.InitAsync();
            var init = sw.ElapsedMilliseconds;
            var fast = await Ocr.RecognizeTextAsync(ms.ToArray(), tryHard: false);
            var fastMs = sw.ElapsedMilliseconds - init;
            sw.Restart();
            var result = await Ocr.RecognizeTextAsync(ms.ToArray(), tryHard: true);
            sw.Stop();
            sb.AppendLine($"FAST tryHard=false {fastMs}ms lines={fast.Lines.Count}: {string.Join(" | ", fast.Lines)}");

            sb.AppendLine($"Success={result.Success} init={init}ms total={sw.ElapsedMilliseconds}ms lines={result.Lines.Count} elements={result.Elements.Count}");
            sb.AppendLine($"SupportedLanguages={string.Join(",", Ocr.SupportedLanguages ?? [])}");
            sb.AppendLine("--- LINES ---");
            foreach (var line in result.Lines) sb.AppendLine(line);
            sb.AppendLine("--- ELEMENTS (distinct boxes) ---");
            foreach (var g in result.Elements.GroupBy(e => (e.X, e.Y, e.Width, e.Height)).OrderBy(g => g.Key.Y))
                sb.AppendLine($"[{g.Key.X},{g.Key.Y} {g.Key.Width}x{g.Key.Height}] {string.Join(" ", g.Select(e => e.Text))}");
        }
        catch (Exception ex)
        {
            sb.AppendLine($"ERROR: {ex}");
        }

        _output = sb.ToString();
        Console.WriteLine("OCRSPIKE_BEGIN\n" + _output + "OCRSPIKE_END");
        await File.WriteAllTextAsync(Path.Combine(FileSystem.AppDataDirectory, "ocr-spike.txt"), _output);
        StateHasChanged();
    }
}
