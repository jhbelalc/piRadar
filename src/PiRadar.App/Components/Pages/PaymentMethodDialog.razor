@inject IPaymentMethodRepository PaymentMethodRepository
@inject IDialogService Dialogs

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                @if (PaymentMethod?.IsArchived == true)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">@Pick("Está archivado: no aparece al registrar movimientos.", "It is archived: it does not appear when adding transactions.")</MudAlert>
                }
                <div class="d-flex align-center gap-3">
                    <IconAvatar Icon="@_icon" Size="Size.Large" />
                    <MudTextField T="string" @bind-Value="_name" Label="@Pick("Nombre", "Name")" Required="true"
                                  RequiredError="@Pick("Escribe un nombre.", "Enter a name.")" MaxLength="40" Variant="Variant.Outlined" />
                </div>
                <MudSelect T="PaymentMethodKind" Value="_kind" ValueChanged="SetKind" Label="@Pick("Tipo", "Type")" Variant="Variant.Outlined"
                           ToStringFunc="PaymentMethodText.Kind">
                    @foreach (var kind in Enum.GetValues<PaymentMethodKind>())
                    {
                        <MudSelectItem Value="kind">@PaymentMethodText.Kind(kind)</MudSelectItem>
                    }
                </MudSelect>
                @if (HasDigits(_kind))
                {
                    <MudTextField T="string" @bind-Value="_lastFour" Label="@Pick("Últimos 4 dígitos (opcional)", "Last 4 digits (optional)")" MaxLength="4"
                                  InputMode="InputMode.numeric" Pattern="[0-9]*" Variant="Variant.Outlined"
                                  Validation="@((Func<string?, string?>)ValidateDigits)"
                                  HelperText="@Pick("Solo para distinguir tarjetas o cuentas; no se guarda el número completo.", "Only to tell cards or accounts apart; the full number is not stored.")" />
                }
                <IconPicker Value="@_icon" ValueChanged="icon => { _icon = icon; _iconTouched = true; }" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (PaymentMethod is { IsArchived: true })
        {
            <MudButton Color="Color.Primary" OnClick="RestoreAsync" Disabled="_busy">@Pick("Restaurar", "Restore")</MudButton>
        }
        else if (PaymentMethod is not null)
        {
            <MudButton Color="Color.Error" OnClick="DeleteAsync" Disabled="_busy">@Pick("Eliminar", "Delete")</MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="() => MudDialog.Cancel()">@Pick("Cancelar", "Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">@Pick("Guardar", "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private string? _name;
    private PaymentMethodKind _kind = PaymentMethodKind.DebitCard;
    private string? _lastFour;
    private string _icon = DefaultIcon(PaymentMethodKind.DebitCard);
    private bool _iconTouched;
    private string? _error;
    private bool _busy;

    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    /// <summary>El medio de pago a editar, o <c>null</c> para crear uno.</summary>
    [Parameter] public PaymentMethod? PaymentMethod { get; set; }

    protected override void OnInitialized()
    {
        if (PaymentMethod is { } p)
        {
            (_name, _kind, _lastFour, _icon, _iconTouched) = (p.Name, p.Kind, p.LastFourDigits, p.Icon, true);
        }
    }

    private static bool HasDigits(PaymentMethodKind kind) =>
        kind is PaymentMethodKind.DebitCard or PaymentMethodKind.CreditCard or PaymentMethodKind.BankAccount;

    private static string DefaultIcon(PaymentMethodKind kind) => kind switch
    {
        PaymentMethodKind.Cash => "payments",
        PaymentMethodKind.DebitCard or PaymentMethodKind.CreditCard => "credit_card",
        PaymentMethodKind.BankAccount => "account_balance",
        PaymentMethodKind.DigitalWallet => "smartphone",
        _ => "account_balance_wallet",
    };

    private void SetKind(PaymentMethodKind kind)
    {
        _kind = kind;
        if (!_iconTouched)
        {
            _icon = DefaultIcon(kind);
        }
    }

    private static string? ValidateDigits(string? value) =>
        string.IsNullOrEmpty(value) || (value.Length == 4 && value.All(char.IsAsciiDigit))
            ? null
            : Pick("Deben ser 4 números.", "Must be 4 digits.");

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        await RunAsync(async () =>
        {
            if (PaymentMethod is null)
            {
                await PaymentMethodRepository.AddAsync(Edited(archived: false));
                return Pick("Medio de pago creado.", "Payment method created.");
            }

            await PaymentMethodRepository.UpdateAsync(Edited(PaymentMethod.IsArchived));
            return Pick("Medio de pago guardado.", "Payment method saved.");
        });
    }

    private Task RestoreAsync() => RunAsync(async () =>
    {
        await PaymentMethodRepository.UpdateAsync(Edited(archived: false));
        return Pick("Medio de pago restaurado.", "Payment method restored.");
    });

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync(Pick("Eliminar medio de pago", "Delete payment method"),
            Pick($"¿Eliminar «{PaymentMethod!.Name}»? Si tiene movimientos se archivará para conservar el historial.",
                 $"Delete “{PaymentMethod!.Name}”? If it has transactions it will be archived to keep the history."),
            Pick("Eliminar", "Delete"));
        if (!confirmed)
        {
            return;
        }

        await RunAsync(async () => await PaymentMethodRepository.DeleteOrArchiveAsync(PaymentMethod.Id) == RemovalResult.Deleted
            ? Pick("Medio de pago eliminado.", "Payment method deleted.")
            : Pick("Se archivó porque tiene movimientos.", "It was archived because it has transactions."));
    }

    private PaymentMethod Edited(bool archived) => new()
    {
        Id = PaymentMethod?.Id ?? 0,
        Name = _name ?? string.Empty,
        Kind = _kind,
        Icon = _icon,
        LastFourDigits = HasDigits(_kind) && !string.IsNullOrEmpty(_lastFour) ? _lastFour : null,
        SortOrder = PaymentMethod?.SortOrder ?? 0,
        IsArchived = archived,
        IsSystem = PaymentMethod?.IsSystem ?? false,
    };

    private async Task RunAsync(Func<Task<string>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            MudDialog.Close(DialogResult.Ok(await action()));
        }
        catch (DomainValidationException ex)
        {
            _error = ex.Message;
        }
        catch (KeyNotFoundException)
        {
            _error = Pick("El medio de pago ya no existe.", "The payment method no longer exists.");
        }
        finally
        {
            _busy = false;
        }
    }
}
