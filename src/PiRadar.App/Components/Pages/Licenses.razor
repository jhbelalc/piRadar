@page "/about/licenses"

<PageBar Title="@Pick("Licencias de terceros", "Third-party licenses")" BackHref="about" />

<MudContainer MaxWidth="MaxWidth.Medium" Class="page-content">
    <MudStack Spacing="3">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @Pick("piRadar usa estos componentes de código abierto y servicios. Gracias a sus autores.", "piRadar uses these open-source components and services. Thanks to their authors.")
        </MudText>

        <MudPaper Elevation="0" Outlined="true">
            <MudList T="string" Dense="true">
                @foreach (var notice in Notices)
                {
                    <MudListItem T="string">
                        <MudText Typo="Typo.subtitle2">@notice.Name</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@notice.Copyright</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@notice.License · @notice.Url</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>

        <MudExpansionPanels Outlined="true" Elevation="0">
            @foreach (var (title, file) in FullTexts)
            {
                <MudExpansionPanel Text="@title">
                    <pre class="license-text">@_texts[file]</pre>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudStack>
</MudContainer>

@code {
    private sealed record Notice(string Name, string Copyright, string License, string Url);

    // Paquetes de PiRadar.App/Core/Data y lo que traen dentro (ver los .csproj). Al agregar uno, sumarlo aquí.
    private static Notice[] Notices =>
    [
        new(".NET y .NET MAUI", "Copyright (c) .NET Foundation and Contributors", Pick("Licencia MIT", "MIT License"), "github.com/dotnet/maui"),
        new("MudBlazor", "Copyright (c) 2021 MudBlazor", Pick("Licencia MIT", "MIT License"), "github.com/MudBlazor/MudBlazor"),
        new("Material Icons", "Copyright Google LLC", Pick("Licencia Apache 2.0", "Apache License 2.0"), "github.com/google/material-design-icons"),
        new("sqlite-net", "Copyright (c) Krueger Systems, Inc.", Pick("Licencia MIT", "MIT License"), "github.com/praeclarum/sqlite-net"),
        new("SQLitePCLRaw", "Copyright 2014-2024 SourceGear, LLC", Pick("Licencia Apache 2.0", "Apache License 2.0"), "github.com/ericsink/SQLitePCL.raw"),
        new("SQLite3 Multiple Ciphers", "Copyright (c) 2019-2026 Ulrich Telle", Pick("Licencia MIT", "MIT License"), "github.com/utelle/SQLite3MultipleCiphers"),
        new("SQLite", Pick("Autores de SQLite", "SQLite authors"), Pick("Dominio público", "Public domain"), "sqlite.org/copyright.html"),
        new("Plugin.Maui.OCR", "Copyright (c) 2024 Kori Francis", Pick("Licencia MIT", "MIT License"), "github.com/kfrancis/ocr"),
        new(Pick("Google ML Kit, reconocimiento de texto (Android)", "Google ML Kit, text recognition (Android)"), "Copyright Google LLC",
            Pick("Términos del servicio de ML Kit", "ML Kit Terms of Service"), "developers.google.com/ml-kit/terms"),
        new(Pick("Enlaces de .NET para Android y ML Kit", ".NET bindings for Android and ML Kit"), "Copyright (c) .NET Foundation Contributors", Pick("Licencia MIT", "MIT License"),
            "github.com/dotnet/android-libraries"),
    ];

    private static (string Title, string File)[] FullTexts =>
    [
        (Pick("Texto de la licencia MIT", "MIT license text"), "MIT.txt"),
        (Pick("Texto de la licencia Apache 2.0", "Apache 2.0 license text"), "Apache-2.0.txt"),
    ];

    private Dictionary<string, string> _texts = [];

    protected override void OnInitialized() => _texts = FullTexts.ToDictionary(t => t.File, t => LoadText(t.File));

    private static string LoadText(string file)
    {
        using var stream = typeof(Licenses).Assembly.GetManifestResourceStream("Licenses." + file)
            ?? throw new InvalidOperationException($"Missing resource Licenses.{file}.");
        using var reader = new StreamReader(stream);

        // Los textos vienen cortados a 80 columnas; en un teléfono se leen mejor como párrafos que se ajustan solos.
        var paragraphs = reader.ReadToEnd().Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries)
            .Select(p => string.Join(' ', p.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)))
            .Where(p => p.Length > 0);
        return string.Join("\n\n", paragraphs);
    }
}
