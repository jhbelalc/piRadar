@inject IExchangeRateRepository ExchangeRateRepository

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudSelect T="Currency" @bind-Value="_from" Label="@Pick("De", "From")" Variant="Variant.Outlined">
                        @foreach (var currency in Enum.GetValues<Currency>())
                        {
                            <MudSelectItem Value="currency">@currency</MudSelectItem>
                        }
                    </MudSelect>
                    <MudIconButton Icon="@Icons.Material.Rounded.SwapHoriz" aria-label="@Pick("Invertir monedas", "Swap currencies")" OnClick="Swap" />
                    <MudSelect T="Currency" @bind-Value="_to" Label="@Pick("A", "To")" Variant="Variant.Outlined">
                        @foreach (var currency in Enum.GetValues<Currency>())
                        {
                            <MudSelectItem Value="currency">@currency</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
                <MudTextField T="string" @bind-Value="_rateText" Label="@Pick($"1 {_from} equivale a ({_to})", $"1 {_from} equals ({_to})")"
                              InputMode="@(InputMode.@decimal)" Variant="Variant.Outlined" Required="true"
                              RequiredError="@Pick("Escribe la tasa.", "Enter the rate.")" Validation="@((Func<string?, string?>)ValidateRate)" />
                <MudDatePicker @bind-Date="_date" Label="@Pick("Aplica desde", "Applies from")" Variant="Variant.Outlined" DateFormat="@(IsEnglish ? "MM/dd/yyyy" : "dd/MM/yyyy")"
                               PickerVariant="PickerVariant.Dialog" AutoClose="true" Required="true"
                               RequiredError="@Pick("Elige la fecha.", "Choose the date.")" ShowToolbar="false"
                               HelperText="@Pick("Si ya hay una tasa de ese par para ese día, se reemplaza.", "If a rate for that pair already exists for that day, it is replaced.")" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@Pick("Cancelar", "Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">@Pick("Guardar", "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Hasta micras: <c>RateMicros</c> guarda la tasa × 10⁶.</summary>
    private const int MaxRateDecimals = 6;

    private MudForm? _form;
    private Currency _from;
    private Currency _to;
    private string? _rateText;
    private DateTime? _date;
    private string? _error;
    private bool _busy;

    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    [Parameter, EditorRequired] public required ExchangeRate Rate { get; set; }

    /// <summary>Si es nueva; al editar, un cambio de par o fecha guarda otra tasa y borra la original.</summary>
    [Parameter] public bool IsNew { get; set; }

    protected override void OnInitialized()
    {
        (_from, _to, _date) = (Rate.From, Rate.To, Rate.EffectiveDate);
        _rateText = Rate.RateMicros > 0 ? MoneyParser.FormatDecimal(Rate.Rate) : null;
    }

    private void Swap() => (_from, _to) = (_to, _from);

    private static string? ValidateRate(string? text)
    {
        if (!MoneyParser.TryParseDecimal(text, out var value))
        {
            return Pick("La tasa no es válida.", "The rate is not valid.");
        }

        if (value <= 0)
        {
            return Pick("La tasa debe ser mayor que cero.", "The rate must be greater than zero.");
        }

        return decimal.Round(value, MaxRateDecimals) != value ? Pick($"Máximo {MaxRateDecimals} decimales.", $"At most {MaxRateDecimals} decimals.") : null;
    }

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || !MoneyParser.TryParseDecimal(_rateText, out var value) || _date is not { } date)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var saved = await ExchangeRateRepository.UpsertAsync(new ExchangeRate
            {
                From = _from, To = _to, Rate = value, EffectiveDate = date.Date,
            });
            if (!IsNew && saved.Id != Rate.Id)
            {
                await ExchangeRateRepository.DeleteAsync(Rate.Id);
            }

            MudDialog.Close(DialogResult.Ok(Pick("Tasa guardada.", "Rate saved.")));
        }
        catch (DomainValidationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
