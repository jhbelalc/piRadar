@using PiRadar.Core.Backup
@inject IBackupService BackupService

@* Crear: contraseña + confirmación y cifra; devuelve los bytes. Abrir: contraseña, descifra y valida; devuelve el
   BackupContents. El trabajo se hace aquí para mostrar el progreso y los errores sin cerrar el diálogo. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (IsExport)
            {
                <MudText Typo="Typo.body2">
                    @if (IsEnglish)
                    {
                        <text>The backup is encrypted with this password. Without it <b>nobody can open it, not even you</b>: keep it somewhere safe.</text>
                    }
                    else
                    {
                        <text>El respaldo se cifra con esta contraseña. Sin ella <b>nadie puede abrirlo, ni siquiera tú</b>: guárdala en un lugar seguro.</text>
                    }
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">@Pick("Escribe la contraseña con la que creaste el respaldo.", "Enter the password you used to create the backup.")</MudText>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" id="backup-error">@_error</MudAlert>
            }

            <MudTextField T="string" @bind-Value="_password" Label="@Pick("Contraseña", "Password")" Variant="Variant.Outlined"
                          InputType="@(_show ? InputType.Text : InputType.Password)" Immediate="true" Disabled="_busy"
                          Adornment="Adornment.End" AdornmentIcon="@(_show ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)"
                          AdornmentAriaLabel="@Pick("Mostrar contraseña", "Show password")" OnAdornmentClick="() => _show = !_show"
                          HelperText="@(IsExport ? Pick($"Mínimo {BackupCrypto.MinPasswordLength} caracteres.", $"At least {BackupCrypto.MinPasswordLength} characters.") : null)" />
            @if (IsExport)
            {
                <MudTextField T="string" @bind-Value="_confirmation" Label="@Pick("Confirmar contraseña", "Confirm password")" Variant="Variant.Outlined"
                              InputType="@(_show ? InputType.Text : InputType.Password)" Immediate="true" Disabled="_busy" />
            }

            @if (_busy)
            {
                <div>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(IsExport ? Pick("Cifrando tus datos…", "Encrypting your data…") : Pick("Descifrando el respaldo…", "Decrypting the backup…")) @Pick("Puede tardar unos segundos.", "It may take a few seconds.")
                    </MudText>
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" Disabled="_busy">@Pick("Cancelar", "Cancel")</MudButton>
        <MudButton id="backup-password-ok" Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @(IsExport ? Pick("Crear respaldo", "Create backup") : Pick("Abrir", "Open"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? _password;
    private string? _confirmation;
    private string? _error;
    private bool _busy;
    private bool _show;

    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    /// <summary>Archivo a abrir; <c>null</c> = crear un respaldo.</summary>
    [Parameter] public byte[]? File { get; set; }

    private bool IsExport => File is null;

    private async Task SubmitAsync()
    {
        _error = IsExport
            ? BackupCrypto.ValidateNewPassword(_password, _confirmation)
            : string.IsNullOrEmpty(_password) ? Pick("Escribe la contraseña.", "Enter the password.") : null;
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            object result = IsExport
                ? await BackupService.ExportAsync(_password!)
                : await BackupService.OpenAsync(File!, _password!);
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (BackupException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
