@using PiRadar.Core.Backup
@inject IBackupService BackupService

@* Crear: contraseña + confirmación y cifra; devuelve los bytes. Abrir: contraseña, descifra y valida; devuelve el
   BackupContents. El trabajo se hace aquí para mostrar el progreso y los errores sin cerrar el diálogo. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (IsExport)
            {
                <MudText Typo="Typo.body2">
                    El respaldo se cifra con esta contraseña. Sin ella <b>nadie puede abrirlo, ni siquiera tú</b>:
                    guárdala en un lugar seguro.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">Escribe la contraseña con la que creaste el respaldo.</MudText>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" id="backup-error">@_error</MudAlert>
            }

            <MudTextField T="string" @bind-Value="_password" Label="Contraseña" Variant="Variant.Outlined"
                          InputType="@(_show ? InputType.Text : InputType.Password)" Immediate="true" Disabled="_busy"
                          Adornment="Adornment.End" AdornmentIcon="@(_show ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)"
                          AdornmentAriaLabel="Mostrar contraseña" OnAdornmentClick="() => _show = !_show"
                          HelperText="@(IsExport ? $"Mínimo {BackupCrypto.MinPasswordLength} caracteres." : null)" />
            @if (IsExport)
            {
                <MudTextField T="string" @bind-Value="_confirmation" Label="Confirmar contraseña" Variant="Variant.Outlined"
                              InputType="@(_show ? InputType.Text : InputType.Password)" Immediate="true" Disabled="_busy" />
            }

            @if (_busy)
            {
                <div>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(IsExport ? "Cifrando tus datos…" : "Descifrando el respaldo…") Puede tardar unos segundos.
                    </MudText>
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" Disabled="_busy">Cancelar</MudButton>
        <MudButton id="backup-password-ok" Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @(IsExport ? "Crear respaldo" : "Abrir")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? _password;
    private string? _confirmation;
    private string? _error;
    private bool _busy;
    private bool _show;

    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    /// <summary>Archivo a abrir; <c>null</c> = crear un respaldo.</summary>
    [Parameter] public byte[]? File { get; set; }

    private bool IsExport => File is null;

    private async Task SubmitAsync()
    {
        _error = IsExport
            ? BackupCrypto.ValidateNewPassword(_password, _confirmation)
            : string.IsNullOrEmpty(_password) ? "Escribe la contraseña." : null;
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            object result = IsExport
                ? await BackupService.ExportAsync(_password!)
                : await BackupService.OpenAsync(File!, _password!);
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (BackupException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
