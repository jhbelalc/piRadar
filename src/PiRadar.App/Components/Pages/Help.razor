@page "/help"
@inject LinkOpener Links

<PageBar Title="@Pick("Ayuda", "Help")" BackHref="more" />

<MudContainer MaxWidth="MaxWidth.Medium" Class="page-content">
    <MudStack Spacing="3">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @Pick("Toca una pregunta para ver cómo se hace, paso a paso.", "Tap a question to see how it is done, step by step.")
        </MudText>

        @foreach (var section in HelpContent.Sections)
        {
            <MudStack Spacing="1" id="@("help-" + section.Id)">
                <MudText Typo="Typo.subtitle1">@section.Title.In(AppLocale.Language)</MudText>
                <MudExpansionPanels Outlined="true" Elevation="0">
                    @foreach (var article in section.Articles)
                    {
                        <MudExpansionPanel Text="@article.Question.In(AppLocale.Language)" id="@("help-" + article.Id)">
                            <HelpArticleView Article="article" />
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </MudStack>
        }

        <MudText Typo="Typo.body2" Class="mud-text-secondary" id="help-contact">
            @Pick("¿No encuentras tu duda? Escribe a", "Cannot find your question? Write to")
            <MudLink Typo="Typo.body2" OnClick="@(() => Links.OpenAsync("mailto:" + HelpContent.ContactEmail))">@HelpContent.ContactEmail</MudLink>
        </MudText>
    </MudStack>
</MudContainer>
