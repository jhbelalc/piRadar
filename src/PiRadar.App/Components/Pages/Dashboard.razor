@page "/"

<PageBar Title="piRadar" />

<MudContainer MaxWidth="MaxWidth.Medium" Class="page-content">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Rounded.Radar" Color="Color.Primary" Style="font-size: 2.5rem" />
                <div>
                    <MudText Typo="Typo.h6">Hola</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Aquí verás el resumen de tus gastos e ingresos del mes. Tus datos se guardan cifrados solo en este dispositivo.
                    </MudText>
                </div>
            </MudStack>
        </MudPaper>
        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Para empezar, revisa</MudText>
        <MudPaper Elevation="0" Outlined="true">
            <MudList T="string">
                @foreach (var item in NavItems.MoreItems.Where(i => i.Enabled && i.Href != "settings"))
                {
                    <MudListItem T="string" Href="@item.Href" Icon="@item.Icon" Text="@item.Label" />
                }
            </MudList>
        </MudPaper>
    </MudStack>
</MudContainer>
