@page "/"
@using PiRadar.Core.Analytics
@using PiRadar.Core.Backup
@inject ITransactionRepository TransactionRepository
@inject ICategoryRepository CategoryRepository
@inject IPaymentMethodRepository PaymentMethodRepository
@inject ISettingsRepository SettingsRepository
@inject TransactionsViewState TransactionsState
@inject NavigationManager Navigation
@inject HomeTitleState HomeTitleState

<PageBar Title="@HomeTitleState.Title" Subtitle="piRadar" />

<MudContainer MaxWidth="MaxWidth.Medium" Class="page-content">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6" id="dashboard-period">@_month.Label</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="transactions/new"
                           StartIcon="@Icons.Material.Rounded.Add">@Pick("Registrar", "Add")</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="scan"
                           StartIcon="@Icons.Material.Rounded.DocumentScanner">@Pick("Escanear", "Scan")</MudButton>
            </MudStack>
        </MudStack>

        @if (_recent is null)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (_recent.Count == 0)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true" id="dashboard-welcome">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Rounded.Radar" Color="Color.Primary" Style="font-size: 2.5rem" />
                    <div>
                        <MudText Typo="Typo.h6">@Pick("Hola", "Hello")</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @Pick("Registra tu primer gasto o ingreso, o escanea un recibo. Aquí verás el resumen del mes. Tus datos se guardan cifrados solo en este dispositivo.",
                                  "Add your first expense or income, or scan a receipt. You will see the month summary here. Your data is stored encrypted on this device only.")
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>
        }
        else
        {
            @if (_backupDue)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Rounded.CloudUpload" id="backup-reminder">
                    @(_lastBackup is { } last
                        ? Pick($"Tu último respaldo es del {DateLabels.Short(last.ToLocalTime())}.",
                               $"Your last backup is from {DateLabels.Short(last.ToLocalTime())}.")
                        : Pick("Aún no has hecho un respaldo de tus datos.", "You have not backed up your data yet."))
                    <MudLink Href="backup" Typo="Typo.body2">@Pick("Hacer respaldo", "Back up now")</MudLink>
                </MudAlert>
            }

            @if (_totals.Count == 0)
            {
                <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                    <MudText Class="mud-text-secondary">@Pick("No hay movimientos este mes.", "No transactions this month.")</MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid Spacing="3">
                    @foreach (var totals in _totals)
                    {
                        var comparison = _comparisons.FirstOrDefault(c => c.Currency == totals.Currency);
                        <MudItem xs="12" sm="@(_totals.Count > 1 ? 6 : 12)">
                            <MudPaper Class="pa-4" Elevation="0" Outlined="true" id="@($"summary-{totals.Currency}")">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Pick("Gastos del mes", "Expenses this month") · @totals.Currency</MudText>
                                <MudText Typo="Typo.h5" Class="money-expense" Style="font-variant-numeric: tabular-nums">
                                    @totals.Expenses
                                </MudText>
                                @if (comparison?.Change is { } change)
                                {
                                    <MudText Typo="Typo.caption" Class="@(change > 0 ? "money-expense" : "money-income")">
                                        @(change > 0 ? "▲" : change < 0 ? "▼" : "=") @Math.Abs(change).ToString("P0")
                                        <span class="mud-text-secondary">@Pick("frente al", "vs.") @_previousLabel</span>
                                    </MudText>
                                }
                                <MudDivider Class="my-3" />
                                <div class="d-flex justify-space-between gap-3">
                                    <div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Pick("Ingresos", "Income")</MudText>
                                        <MudText Typo="Typo.body2" Class="money-income" Style="font-variant-numeric: tabular-nums">
                                            @totals.Income
                                        </MudText>
                                    </div>
                                    <div style="text-align: right">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Pick("Balance", "Balance")</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight: 600; font-variant-numeric: tabular-nums">
                                            @totals.Balance
                                        </MudText>
                                    </div>
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }

            @foreach (var (currency, shares) in _shares)
            {
                <div id="@($"categories-{currency}")">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-1 ml-1">
                        @Pick("En qué gastas", "Where you spend")@(_shares.Count > 1 ? $" · {currency}" : "")
                    </MudText>
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                        <ShareList Rows="shares" MaxRows="TopCategories" />
                    </MudPaper>
                </div>
            }

            <div>
                <div class="d-flex align-center justify-space-between">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary ml-1">@Pick("Últimos movimientos", "Recent transactions")</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="ShowAll" id="dashboard-all">
                        @Pick("Ver todos", "See all")
                    </MudButton>
                </div>
                <MudPaper Elevation="0" Outlined="true">
                    <MudList T="Transaction" Dense="true">
                        @foreach (var t in _recent)
                        {
                            <TransactionListItem Transaction="t" Category="_categories.GetValueOrDefault(t.CategoryId)"
                                                 PaymentMethod="PaymentMethodOf(t)" ShowDay="true" />
                        }
                    </MudList>
                </MudPaper>
            </div>
        }
    </MudStack>
</MudContainer>

@code {
    private const int TopCategories = 5;
    private const int RecentCount = 5;

    private readonly Period _month = Period.Containing(DateTime.Today, PeriodGranularity.Month);
    private IReadOnlyList<Transaction>? _recent;
    private IReadOnlyList<CurrencyTotals> _totals = [];
    private IReadOnlyList<ExpenseComparison> _comparisons = [];
    private List<(Currency Currency, IReadOnlyList<ShareRow> Shares)> _shares = [];
    private string _previousLabel = "";
    private DateTime? _lastBackup;
    private bool _backupDue;
    private Dictionary<int, Category> _categories = [];
    private Dictionary<int, PaymentMethod> _paymentMethods = [];

    protected override async Task OnInitializedAsync()
    {
        // Con archivados: los movimientos viejos pueden usarlos.
        _categories = (await CategoryRepository.GetAllAsync(includeArchived: true)).ToDictionary(c => c.Id);
        _paymentMethods = (await PaymentMethodRepository.GetAllAsync(includeArchived: true)).ToDictionary(p => p.Id);

        var now = DateTime.Now;
        var (previousStart, previousEnd) = ExpenseComparison.PreviousSpan(_month, now);
        _previousLabel = SpanLabel(previousStart, previousEnd);

        var twoMonths = await TransactionRepository.QueryAsync(TransactionFilter.Between(previousStart, _month.End));
        var month = twoMonths.Where(t => _month.Contains(t.OccurredAt)).ToList();
        _totals = CurrencyTotals.ByCurrency(month);
        _comparisons = ExpenseComparison.ByCurrency(twoMonths, _month, now);
        _shares = _totals
            .Where(t => !t.Expenses.IsZero)
            .Select(t => (t.Currency, ShareRow.FromCategories(CategoryShare.Expenses(month, t.Currency, _categories), _categories)))
            .ToList();

        _recent = await TransactionRepository.QueryAsync(new TransactionFilter { Take = RecentCount });
        _lastBackup = await SettingsRepository.GetLastBackupAtAsync();
        _backupDue = BackupReminder.IsDue(_lastBackup, DateTime.UtcNow);
    }

    /// <summary>"1–26 ago", "1 ago" o, para el mes completo, "mes de agosto" ("Aug 1–26", "Aug 1", "August").</summary>
    private static string SpanLabel(DateTime start, DateTime end)
    {
        var last = end.AddDays(-1);
        if (end == start.AddMonths(1))
        {
            return Pick($"mes de {DateLabels.MonthName(start.Month)}", DateLabels.MonthName(start.Month));
        }

        var month = DateLabels.MonthAbbreviation(last.Month);
        if (IsEnglish)
        {
            return last.Day == start.Day ? $"{month} {start.Day}" : $"{month} {start.Day}–{last.Day}";
        }

        return last.Day == start.Day ? $"{start.Day} {month}" : $"{start.Day}–{last.Day} {month}";
    }

    private PaymentMethod? PaymentMethodOf(Transaction t) =>
        t.PaymentMethodId is { } id ? _paymentMethods.GetValueOrDefault(id) : null;

    private void ShowAll()
    {
        TransactionsState.Period = _month;
        TransactionsState.Type = null;
        Navigation.NavigateTo("transactions");
    }
}
