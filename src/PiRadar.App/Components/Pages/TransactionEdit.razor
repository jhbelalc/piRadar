@page "/transactions/new"
@page "/transactions/{Id:guid}"
@inject ITransactionRepository TransactionRepository
@inject IReceiptRepository ReceiptRepository
@inject ICategoryRepository CategoryRepository
@inject ISettingsRepository SettingsRepository
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ScanState ScanState
@using PiRadar.Core.Receipts

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<PageBar Title="@PageTitle" BackHref="@(_scan is null ? "transactions" : "scan")" HelpTopics="HelpTopics.Transaction">
    <Actions>
        @if (!IsNew && _loaded)
        {
            <MudIconButton id="delete-transaction" Icon="@Icons.Material.Rounded.DeleteOutline" Color="Color.Inherit"
                           aria-label="@Pick("Eliminar movimiento", "Delete transaction")" OnClick="DeleteAsync" />
        }
    </Actions>
</PageBar>

<MudContainer MaxWidth="MaxWidth.Small" Class="page-content">
    @if (!_loaded)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (_notFound)
    {
        <MudText Class="mud-text-secondary">@Pick("Este movimiento ya no existe.", "This transaction no longer exists.")</MudText>
    }
    else
    {
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }

                @if (IsNew && _scan is null)
                {
                    <MudButton id="scan-receipt" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Rounded.DocumentScanner" Href="scan">@Pick("Escanear recibo", "Scan receipt")</MudButton>
                }

                @if (_scan is not null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Rounded.DocumentScanner">
                        @Pick("Valores leídos del recibo: revísalos antes de guardar.", "Values read from the receipt: review them before saving.")
                        @foreach (var hint in _scanHints)
                        {
                            <br />@hint
                        }
                    </MudAlert>
                }

                <MudToggleGroup T="TransactionType" Value="_type" ValueChanged="SetTypeAsync" SelectionMode="SelectionMode.SingleSelection"
                                Color="@(_type == TransactionType.Expense ? Color.Error : Color.Success)" CheckMark="false" Style="width: 100%">
                    <MudToggleItem Value="TransactionType.Expense" Text="@Pick("Gasto", "Expense")" />
                    <MudToggleItem Value="TransactionType.Income" Text="@Pick("Ingreso", "Income")" />
                </MudToggleGroup>

                <div class="d-flex align-start gap-3">
                    <div style="flex: 1">
                        <MoneyInput @bind-Value="_amount" Currency="_currency" Label="@Pick("Monto", "Amount")" />
                    </div>
                    <div class="pt-2">
                        <CurrencyToggle @bind-Value="_currency" Size="Size.Medium" />
                    </div>
                </div>

                @if (_totalChoices.Count > 0)
                {
                    <div class="d-flex align-center flex-wrap gap-1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mr-1">@Pick("¿Otro total?", "Another total?")</MudText>
                        @foreach (var total in _totalChoices)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                     Class="total-choice" OnClick="() => ChooseTotal(total)">@total</MudChip>
                        }
                    </div>
                }

                <CategoryPicker @bind-Value="_categoryId" Kind="_type" />

                <div class="d-flex gap-3">
                    <MudDatePicker @bind-Date="_date" Label="@Pick("Fecha", "Date")" Variant="Variant.Outlined" DateFormat="@(IsEnglish ? "MM/dd/yyyy" : "dd/MM/yyyy")"
                                   PickerVariant="PickerVariant.Dialog" AutoClose="true" Required="true"
                                   RequiredError="@Pick("Elige la fecha.", "Choose the date.")" ShowToolbar="false" />
                    @* El ancho va en un contenedor: un Style en el MudTimePicker también se aplica a su diálogo y lo deja
                       angosto y cortado. *@
                    <div class="time-field">
                        <MudTimePicker @bind-Time="_time" Label="@Pick("Hora", "Time")" Variant="Variant.Outlined" TimeFormat="@(IsEnglish ? "hh:mm tt" : "HH:mm")"
                                       PickerVariant="PickerVariant.Dialog" AutoClose="true" AmPm="@IsEnglish" Required="true"
                                       RequiredError="@Pick("Elige la hora.", "Choose the time.")" />
                    </div>
                </div>

                <PaymentMethodPicker @bind-Value="_paymentMethodId" />

                <MudAutocomplete T="string" @bind-Value="_merchant" Label="@Pick("Comercio (opcional)", "Merchant (optional)")" Variant="Variant.Outlined"
                                 SearchFunc="SearchMerchantsAsync" CoerceText="false" CoerceValue="true" MaxLength="80"
                                 MaxItems="8" MinCharacters="1" ShowProgressIndicator="false" OpenIcon="@string.Empty" />

                @if (_merchantChoices.Count > 1)
                {
                    <div class="d-flex align-center flex-wrap gap-1" style="margin-top: -8px">
                        @foreach (var merchant in _merchantChoices)
                        {
                            <MudChip T="string" Size="Size.Small" Class="merchant-choice"
                                     Variant="@(merchant == _merchant ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                                     OnClick="() => _merchant = merchant">@merchant</MudChip>
                        }
                    </div>
                }

                <MudTextField T="string" @bind-Value="_description" Label="@Pick("Descripción (opcional)", "Description (optional)")" Variant="Variant.Outlined"
                              MaxLength="120" />

                <MudTextField T="string" @bind-Value="_notes" Label="@Pick("Notas (opcional)", "Notes (optional)")" Variant="Variant.Outlined"
                              Lines="3" MaxLength="500" />

                @if (_receiptImage is not null)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@Pick("Recibo", "Receipt")</MudText>
                        <img src="@_receiptImage" alt="@Pick("Foto del recibo", "Receipt photo")" style="width: 100%; border-radius: 8px" />
                        @if (!string.IsNullOrWhiteSpace(_receiptText))
                        {
                            <MudButton id="receipt-text" Variant="Variant.Text" Color="Color.Primary" Class="mt-1"
                                       StartIcon="@Icons.Material.Rounded.Notes" OnClick="ShowReceiptTextAsync">@Pick("Ver texto leído", "View text read")</MudButton>
                        }
                    </MudPaper>
                }
                else if (_source == TransactionSource.Ocr)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Pick("Registrado desde un recibo.", "Added from a receipt.")</MudText>
                }

                <MudButton id="save-transaction" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           FullWidth="true" OnClick="SaveAsync" Disabled="_busy">@Pick("Guardar", "Save")</MudButton>
            </MudStack>
        </MudForm>
    }
</MudContainer>

@code {
    private MudForm? _form;
    private bool _loaded;
    private bool _notFound;
    private bool _busy;
    private string? _error;

    private Transaction? _original;
    private TransactionType _type = TransactionType.Expense;
    private Money? _amount;
    private Currency _currency;
    private int? _categoryId;
    private DateTime? _date;
    private TimeSpan? _time;
    private int? _paymentMethodId;
    private string? _merchant;
    private string? _description;
    private string? _notes;
    private TransactionSource _source = TransactionSource.Manual;
    private string? _receiptImage;
    private string? _receiptText;
    private IReadOnlyList<string> _merchants = [];
    private PendingScan? _scan;
    private IReadOnlyList<Money> _totalChoices = [];
    private IReadOnlyList<string> _merchantChoices = [];
    private List<string> _scanHints = [];

    [Parameter] public Guid? Id { get; set; }

    /// <summary><c>?type=Income</c> abre el formulario como ingreso.</summary>
    [SupplyParameterFromQuery(Name = "type")] public string? InitialType { get; set; }

    /// <summary><c>?scan=1</c>: viene de ScanReceipt con un recibo leído en <see cref="ScanState"/>.</summary>
    [SupplyParameterFromQuery(Name = "scan")] public string? FromScan { get; set; }

    private bool IsNew => Id is null;

    private string PageTitle => _scan is not null ? Pick("Nuevo desde recibo", "New from receipt")
        : IsNew ? Pick("Nuevo movimiento", "New transaction") : Pick("Editar movimiento", "Edit transaction");

    protected override async Task OnInitializedAsync()
    {
        _merchants = await TransactionRepository.GetRecentMerchantsAsync();
        if (IsNew)
        {
            await InitNewAsync();
            if (FromScan == "1" && ScanState.Take() is { } scan)
            {
                await InitFromScanAsync(scan);
            }
        }
        else if (await TransactionRepository.GetAsync(Id!.Value) is { } transaction)
        {
            await InitEditAsync(transaction);
        }
        else
        {
            _notFound = true;
        }

        _initialSnapshot = Snapshot();
        _loaded = true;
    }

    // Huella del formulario al abrirlo: si cambia (o viene de un escaneo, que se perdería) hay algo sin guardar.
    private string? _initialSnapshot;
    private bool _leaving;

    private string Snapshot() => string.Join('|', _type, _amount, _currency, _categoryId, _date, _time,
        _paymentMethodId, _merchant, _description, _notes);

    private bool IsDirty => _loaded && !_notFound && (_scan is not null || Snapshot() != _initialSnapshot);

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (_leaving || !IsDirty)
        {
            return;
        }

        var message = _scan is null
            ? Pick("Perderás los datos de este movimiento.", "You will lose the data of this transaction.")
            : Pick("Perderás los datos de este movimiento y el recibo leído.", "You will lose the data of this transaction and the receipt that was read.");
        if (!await Dialogs.ConfirmAsync(Pick("¿Salir sin guardar?", "Leave without saving?"), message, Pick("Salir", "Leave")))
        {
            context.PreventNavigation();
        }
    }

    // Moneda y medio de pago del último movimiento: lo más probable es que se repitan.
    private async Task InitNewAsync()
    {
        if (string.Equals(InitialType, nameof(TransactionType.Income), StringComparison.OrdinalIgnoreCase))
        {
            _type = TransactionType.Income;
        }

        var last = (await TransactionRepository.QueryAsync(TransactionFilter.All with { Take = 1 })).FirstOrDefault();
        _currency = last?.Amount.Currency ?? await SettingsRepository.GetBaseCurrencyAsync();
        _paymentMethodId = last?.PaymentMethodId;
        var now = DateTime.Now;
        (_date, _time) = (now.Date, new TimeSpan(now.Hour, now.Minute, 0));
    }

    // El parser solo propone: se prellena el formulario y el usuario confirma.
    private async Task InitFromScanAsync(PendingScan scan)
    {
        _scan = scan;
        var parsed = scan.Parsed;
        _type = TransactionType.Expense;
        _currency = parsed.Currency;
        _amount = parsed.Total;
        _totalChoices = parsed.TotalCandidates.Where(t => t != parsed.Total).ToList();
        _receiptImage = "data:image/jpeg;base64," + Convert.ToBase64String(scan.Image.Jpeg);
        _receiptText = string.Join('\n', parsed.Rows);

        if (parsed.Date is { } date)
        {
            _date = date.Date;
            if (parsed.HasTime)
            {
                _time = new TimeSpan(date.Hour, date.Minute, 0);
            }
        }

        // Lo que el usuario eligió la última vez para este NIT pesa más que lo que lee el parser.
        var previous = parsed.TaxId is { } taxId ? await TransactionRepository.GetLatestForTaxIdAsync(taxId) : null;
        _merchantChoices = MerchantSuggestions.Combine(previous?.Merchant, parsed.MerchantCandidates);
        _merchant = _merchantChoices.FirstOrDefault();
        if (previous is not null)
        {
            if (await CategoryRepository.GetAsync(previous.CategoryId) is { IsArchived: false, Kind: TransactionType.Expense })
            {
                _categoryId = previous.CategoryId;
            }

            _paymentMethodId = previous.PaymentMethodId ?? _paymentMethodId;
        }

        // Sin categoría de la última vez para este comercio: "Otros gastos" por defecto (el usuario la cambia si quiere).
        if (_categoryId is null
            && DefaultCategories.FindOtherExpense(await CategoryRepository.GetAllAsync(TransactionType.Expense)) is { } other)
        {
            _categoryId = other.Id;
            _scanHints.Add(Pick($"No se detectó la categoría: se puso «{other.Name}». Cámbiala si quieres.",
                                $"The category was not detected: “{other.Name}” was set. Change it if you like."));
        }

        if (parsed.Total is null)
        {
            _scanHints.Add(Pick("No se encontró el total: escríbelo.", "The total was not found: enter it."));
        }
        else if (!parsed.TotalConfirmed)
        {
            _scanHints.Add(Pick("Revisa el total: no cuadró con otra parte del recibo.", "Check the total: it did not match another part of the receipt."));
        }

        if (parsed.Date is null)
        {
            _scanHints.Add(Pick("No se encontró la fecha: se dejó la de hoy.", "The date was not found: today's date was left."));
        }
    }

    private void ChooseTotal(Money total)
    {
        var current = _amount;
        (_amount, _currency) = (total, total.Currency);
        _totalChoices = _totalChoices.Where(t => t != total).Concat(current is { } c ? [c] : []).ToList();
    }

    private async Task InitEditAsync(Transaction t)
    {
        _original = t;
        (_type, _amount, _currency, _categoryId) = (t.Type, t.Amount, t.Amount.Currency, t.CategoryId);
        (_date, _time) = (t.OccurredAt.Date, new TimeSpan(t.OccurredAt.Hour, t.OccurredAt.Minute, 0));
        (_paymentMethodId, _merchant, _description, _notes, _source) =
            (t.PaymentMethodId, t.Merchant, t.Description, t.Notes, t.Source);

        if (t.ReceiptId is { } receiptId && await ReceiptRepository.GetImageAsync(receiptId) is { } image)
        {
            _receiptImage = "data:image/jpeg;base64," + Convert.ToBase64String(image.Jpeg);
            _receiptText = (await ReceiptRepository.GetAsync(receiptId))?.OcrText;
        }
    }

    private async Task ShowReceiptTextAsync()
    {
        var parameters = new DialogParameters<ReceiptTextDialog> { { d => d.Text, _receiptText ?? string.Empty } };
        await Dialogs.ShowAsync<ReceiptTextDialog>(Pick("Texto leído del recibo", "Text read from the receipt"), parameters, DialogExtensions.FormOptions);
    }

    private async Task SetTypeAsync(TransactionType type)
    {
        _type = type;

        // Las categorías son de gastos o de ingresos: la elegida deja de servir al cambiar el tipo.
        if (_categoryId is { } id && await CategoryRepository.GetAsync(id) is { } category && category.Kind != type)
        {
            _categoryId = null;
        }
    }

    // Sin distinguir tildes ni mayúsculas, con los que empiezan por el texto primero.
    private Task<IEnumerable<string>> SearchMerchantsAsync(string? text, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return Task.FromResult(Enumerable.Empty<string>());
        }

        var compare = System.Globalization.CultureInfo.InvariantCulture.CompareInfo;
        const System.Globalization.CompareOptions options =
            System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace;
        var query = text.Trim();
        var matches = _merchants
            .Where(m => compare.IndexOf(m, query, options) >= 0)
            .OrderBy(m => compare.IsPrefix(m, query, options) ? 0 : 1);
        return Task.FromResult<IEnumerable<string>>(matches.ToList());
    }

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || _amount is not { } amount || _categoryId is not { } categoryId
            || _date is not { } date || _time is not { } time)
        {
            _error = _categoryId is null ? Pick("Elige una categoría.", "Choose a category.") : null;
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var transaction = new Transaction
            {
                Id = _original?.Id ?? Guid.Empty,
                Type = _type,
                Amount = amount,
                OccurredAt = DateTime.SpecifyKind(date.Date + time, DateTimeKind.Local),
                CategoryId = categoryId,
                PaymentMethodId = _paymentMethodId,
                Merchant = _merchant,
                Description = _description,
                Notes = _notes,
            };

            if (_scan is { } scan)
            {
                var parsed = scan.Parsed;
                var receipt = new Receipt
                {
                    OcrText = string.Join('\n', parsed.Rows),
                    ParsedTotal = parsed.Total,
                    ParsedDate = parsed.Date,
                    ParsedMerchant = parsed.Merchant,
                    ParsedTaxId = parsed.TaxId,
                    OcrEngine = scan.OcrEngine,
                };
                await TransactionRepository.AddWithReceiptAsync(transaction, receipt, scan.Image);
                Snackbar.Add(Pick("Movimiento y recibo guardados.", "Transaction and receipt saved."), Severity.Success);
            }
            else if (IsNew)
            {
                await TransactionRepository.AddAsync(transaction);
                Snackbar.Add(Pick("Movimiento guardado.", "Transaction saved."), Severity.Success);
            }
            else
            {
                await TransactionRepository.UpdateAsync(transaction);
                Snackbar.Add(Pick("Cambios guardados.", "Changes saved."), Severity.Success);
            }

            _leaving = true;
            Navigation.NavigateTo("transactions");
        }
        catch (DomainValidationException ex)
        {
            _error = ex.Message;
        }
        catch (KeyNotFoundException)
        {
            _error = Pick("Este movimiento ya no existe.", "This transaction no longer exists.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        var message = _original?.ReceiptId is null
            ? Pick("¿Eliminar este movimiento? Esta acción no se puede deshacer.", "Delete this transaction? This cannot be undone.")
            : Pick("¿Eliminar este movimiento y la foto de su recibo? Esta acción no se puede deshacer.", "Delete this transaction and its receipt photo? This cannot be undone.");
        if (!await Dialogs.ConfirmAsync(Pick("Eliminar movimiento", "Delete transaction"), message, Pick("Eliminar", "Delete")))
        {
            return;
        }

        await TransactionRepository.DeleteAsync(Id!.Value);
        Snackbar.Add(Pick("Movimiento eliminado.", "Transaction deleted."), Severity.Success);
        _leaving = true;
        Navigation.NavigateTo("transactions");
    }
}
