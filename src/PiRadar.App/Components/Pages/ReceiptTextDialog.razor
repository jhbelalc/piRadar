@inject ISnackbar Snackbar

@* Filas que el OCR leyó del recibo, tal como las recibe el parser. Para revisar una lectura dudosa; el texto solo sale
   del teléfono si el usuario lo copia. *@
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filas tal como las leyó el teléfono.</MudText>
        <pre id="receipt-text-rows" class="receipt-text">@Text</pre>
    </DialogContent>
    <DialogActions>
        <MudButton id="receipt-text-copy" StartIcon="@Icons.Material.Rounded.ContentCopy" OnClick="CopyAsync">Copiar</MudButton>
        <MudButton id="receipt-text-close" Color="Color.Primary" Variant="Variant.Filled" OnClick="() => MudDialog.Close()">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    [Parameter] public string Text { get; set; } = string.Empty;

    private async Task CopyAsync()
    {
        await MainThread.InvokeOnMainThreadAsync(() => Clipboard.Default.SetTextAsync(Text));
        Snackbar.Add("Texto copiado.", Severity.Success);
    }
}
