@* Barra superior de cada página: título, botón atrás opcional y acciones. *@
<MudAppBar Fixed="true" Elevation="0">
    @if (BackHref is not null)
    {
        <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Color="Color.Inherit" Edge="Edge.Start"
                       Href="@BackHref" aria-label="@Pick("Volver", "Back")" />
    }
    @if (Subtitle is null)
    {
        <MudText Typo="Typo.h6" Class="ml-2" Style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis">@Title</MudText>
    }
    else
    {
        <AppTitle Title="@Title" Subtitle="@Subtitle" Class="ml-2" />
    }
    <MudSpacer />
    @if (HelpTopics is { Length: > 0 })
    {
        <HelpButton Topics="HelpTopics" />
    }
    @Actions
</MudAppBar>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Segunda línea bajo el título (Inicio: "piRadar"); con ella el título puede ocupar 2 líneas.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Página a la que vuelve la flecha; sin flecha si es <c>null</c>.</summary>
    [Parameter] public string? BackHref { get; set; }

    /// <summary>Artículos de ayuda de esta pantalla (<c>PiRadar.Core.Help.HelpTopics</c>); con ellos aparece el botón "?".</summary>
    [Parameter] public string[]? HelpTopics { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
}
