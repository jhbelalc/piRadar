@* Monto de un movimiento: "-$ 82.150" en rojo para gastos, "+$ 3.000.000" en verde para ingresos. *@
<MudText Typo="Typo" Class="@($"{(Type == TransactionType.Expense ? "money-expense" : "money-income")} {Class}")"
         Style="white-space: nowrap; font-variant-numeric: tabular-nums">
    @(Type == TransactionType.Expense ? "-" : "+")@Amount
</MudText>

@code {
    [Parameter, EditorRequired] public Money Amount { get; set; }
    [Parameter, EditorRequired] public TransactionType Type { get; set; }
    [Parameter] public Typo Typo { get; set; } = Typo.body1;
    [Parameter] public string? Class { get; set; }
}
